# Copy to .env and fill in. NEVER commit .env.

# --- Required in production ---
NODE_ENV=production
# 32+ random chars, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# First admin, created only when the users table is empty:
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- Optional ---
PORT=5000
JWT_EXPIRY=12h
APP_TIMEZONE=Asia/Kolkata
# Only needed if the frontend is hosted on a different origin (comma-separated)
CORS_ORIGIN=
# Frontend build-time: API base URL when the UI is hosted separately (e.g. https://api.example.com)
VITE_API_URL=
# Temporary frontend-only testing mode. Stores demo data in this browser's localStorage.
# Set to true for a Vercel-only demo; remove or set false when the backend is deployed.
VITE_DEMO_MODE=false
# Development only: demo users/data are seeded automatically when NODE_ENV != production.
# SEED_DEMO_DATA=true|false
